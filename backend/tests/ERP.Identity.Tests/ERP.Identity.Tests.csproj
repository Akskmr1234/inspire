    <RootNamespace>ERP.Identity.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ERP.Identity\ERP.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
