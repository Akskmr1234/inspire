<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure unit tests over domain invariants: double-entry balance, batch costing,
    reverse-tax arithmetic, numbering series, serial-number state transitions.
    No database, no container, no I/O - these must run in milliseconds.
  -->

  <PropertyGroup>
    <!-- xunit.v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>ERP.Domain.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ERP.Domain\ERP.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
